---
const links = [
  { href: '/#projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="nav-wrapper">
  <nav class="nav">
    <a href="/" class="logo">Abisoye</a>

    <div class="nav-right">
      <ul class="links">
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>

      <button id="search-btn" class="search-btn" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </button>

      <a
        href="https://drive.google.com/file/d/1urTpC48Zsf-uCWZtGkd-lW1EUfFmlhF5/view"
        target="_blank"
        rel="noopener"
        class="btn"
        style="padding: 0.45rem 0.9rem; font-size: 0.8rem;"
      >
        CV
      </a>
    </div>
  </nav>
</header>

<!-- Search Modal -->
<div id="search-modal" class="search-modal" hidden>
  <div class="search-backdrop"></div>
  <div class="search-panel">
    <input
      type="search"
      id="search-input"
      placeholder="Search posts..."
      autocomplete="off"
    />
    <div id="search-results" class="search-results"></div>
  </div>
</div>

<style>
  .nav-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav {
    max-width: 900px;
    margin: 0 auto;
    padding: 0.9rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--white);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
  }

  .links a {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .links a:hover {
    color: var(--white);
  }

  .search-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.25rem;
    display: flex;
  }

  .search-btn:hover {
    color: var(--white);
  }

  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 15vh;
  }

  .search-modal[hidden] {
    display: none;
  }

  .search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
  }

  .search-panel {
    position: relative;
    width: min(560px, 92vw);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
  }

  .search-panel input {
    border: none;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    font-size: 1.05rem;
    padding: 1rem 1.25rem;
  }

  .search-results {
    max-height: 360px;
    overflow-y: auto;
  }

  .search-results a {
    display: block;
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }

  .search-results a:hover {
    background: #181818;
  }

  .search-results .title {
    font-weight: 500;
    margin-bottom: 0.2rem;
  }

  .search-results .meta {
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .search-results .empty {
    padding: 1.5rem;
    text-align: center;
    color: var(--text-dim);
  }

  @media (max-width: 640px) {
    .links {
      display: none;
    }
  }
</style>
