---
---

<section class="hero">
    <div class="container hero-inner">
        <img
            src="/profile.jpg"
            alt="Durojaiye Abisoye"
            class="avatar"
            width="96"
            height="96"
        />

        <h1>Durojaiye Abisoye</h1>
        <p class="role">Machine Learning Engineer</p>

        <p class="bio">
            Working on MLOps and LLMOps. Tinkering, deploying, monitoring (and
            occasionally breaking) ML systems in production.
        </p>

        <div class="actions">
            <a href="#projects" class="btn btn-primary">
                View Projects
            </a>
            <a href="#contact" class="btn">
                Get in touch
            </a>
        </div>
    </div>
</section>

<style>
    .hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        padding: 6rem 0 4rem;
    }

    .hero-inner {
        text-align: center;
    }

    .avatar {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        object-fit: cover;
        margin: 0 auto 1.75rem;
        border: 1px solid var(--border);
    }

    h1 {
        font-size: clamp(2.2rem, 5vw, 3rem);
        margin-bottom: 0.5rem;
    }

    .role {
        color: var(--text-muted);
        font-size: 1.05rem;
        margin-bottom: 1.5rem;
    }

    .bio {
        max-width: 480px;
        margin: 0 auto 2.25rem;
        color: var(--text-muted);
        font-size: 1.05rem;
    }

    .actions {
        display: flex;
        gap: 0.75rem;
        justify-content: center;
        flex-wrap: wrap;
    }
</style>
