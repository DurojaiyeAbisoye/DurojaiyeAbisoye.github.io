---

<section class="hero">
    <div class="container hero-inner">
        <img
            src="/profile.jpg"
            alt="Durojaiye Abisoye"
            class="avatar"
            width="96"
            height="96"
        />

        <h1>Durojaiye Abisoye</h1>
        <p class="role">Machine Learning Engineer</p>

        <p class="bio">
            Working on MLOps and LLMOps. Tinkering, deploying, monitoring (and
            occasionally breaking) ML systems in production.
        </p>

        <div class="social-links" aria-label="Contact and social links">
            <a href="mailto:abisoyeodurojaiye@gmail.com" aria-label="Email Abisoye" title="Email">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 5h18v14H3z"></path>
                    <path d="m3 6 9 7 9-7"></path>
                </svg>
            </a>
            <a href="https://github.com/DurojaiyeAbisoye" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile" title="GitHub">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 6v-3.9a3.4 3.4 0 0 0-.9-2.7c3-.3 6.2-1.5 6.2-6.7a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.6S17.6 1.2 15 3.1a13 13 0 0 0-7 0C5.4 1.2 4.2 1.5 4.2 1.5a4.8 4.8 0 0 0-.1 3.6 5.2 5.2 0 0 0-1.4 3.6c0 5.2 3.2 6.4 6.2 6.7a3.4 3.4 0 0 0-.9 2.7V22"></path>
                </svg>
            </a>
            <a href="https://www.linkedin.com/in/abisoye-durojaiye" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile" title="LinkedIn">
                <svg class="linkedin-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="3"></rect>
                    <path d="M6.5 10h2v7.5h-2zM7.5 6.5a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2ZM11 10h2v1c.5-.7 1.3-1.2 2.4-1.2 2.1 0 2.8 1.3 2.8 3.4v4.3h-2v-4c0-1.1-.2-1.8-1.4-1.8s-1.8.8-1.8 2v3.8h-2z"></path>
                </svg>
            </a>
        </div>

    </div>
</section>

<style>
    .hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        padding: 6rem 0 4rem;
    }

    .hero-inner {
        text-align: center;
    }

    .avatar {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        object-fit: cover;
        margin: 0 auto 1.75rem;
        border: 1px solid var(--border);
    }

    h1 {
        font-size: clamp(2.2rem, 5vw, 3rem);
        margin-bottom: 0.5rem;
    }

    .role {
        color: var(--text-muted);
        font-size: 1.05rem;
        margin-bottom: 1.5rem;
    }

    .bio {
        max-width: 480px;
        margin: 0 auto 1.5rem;
        color: var(--text-muted);
        font-size: 1.05rem;
    }

    .social-links {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-bottom: 2.25rem;
    }

    .social-links a {
        display: inline-flex;
        width: 2.75rem;
        height: 2.75rem;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border);
        border-radius: 50%;
        color: var(--text-muted);
        transition: color 0.2s, border-color 0.2s, background 0.2s;
    }

    .social-links a:hover {
        color: var(--white);
        border-color: var(--silver);
        background: var(--surface);
    }

    .social-links svg {
        width: 1.2rem;
        height: 1.2rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.7;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .social-links .linkedin-icon rect {
        fill: none;
        stroke: currentColor;
    }

    .social-links .linkedin-icon path {
        fill: currentColor;
        stroke: none;
    }

</style>
