---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout title={`${frontmatter.title} — Durojaiye Abisoye`}>
  <Nav />
  <main class="container" style="padding-top: 6rem; padding-bottom: 4rem;">
    <article>
      <header style="margin-bottom: 3rem;">
        <p class="dim" style="font-size: 0.85rem; margin-bottom: 0.75rem;">
          {frontmatter.date instanceof Date
            ? frontmatter.date.toISOString().slice(0, 10)
            : frontmatter.date}
          {frontmatter.tags && frontmatter.tags.length > 0 && (
            <>
              {' · '}
              {frontmatter.tags.join(', ')}
            </>
          )}
        </p>
        <h1 style="font-size: clamp(1.8rem, 4vw, 2.5rem); line-height: 1.2;">
          {frontmatter.title}
        </h1>
        {frontmatter.summary && (
          <p class="muted" style="margin-top: 1rem; font-size: 1.1rem;">
            {frontmatter.summary}
          </p>
        )}
      </header>

      <div class="prose">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .prose {
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose :global(h2) {
    margin: 2.5rem 0 1rem;
    font-size: 1.4rem;
  }
  .prose :global(h3) {
    margin: 2rem 0 0.75rem;
    font-size: 1.15rem;
  }
  .prose :global(p) {
    margin-bottom: 1.25rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 1.25rem 0 1.25rem 1.5rem;
  }
  .prose :global(li) {
    margin-bottom: 0.4rem;
  }
  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(code) {
    background: var(--surface);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
  }
  .prose :global(pre) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1.75rem 0;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--border);
    padding-left: 1.25rem;
    margin: 1.75rem 0;
    color: var(--text-muted);
  }
</style>
