---
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Durojaiye Abisoye",
    description = "Data Scientist & Machine Learning Engineer",
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="alternate" type="application/rss+xml" title="Durojaiye Abisoye — RSS" href="/rss.xml" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
            rel="stylesheet"
        />
        <link
            rel="icon"
            type="image/svg+xml"
            href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='12' fill='%230a0a0a'/><text y='.9em' font-size='55' x='50%' dominant-baseline='middle' text-anchor='middle' fill='%23c0c0c0' font-family='system-ui' font-weight='600'>A</text></svg>"
        />
    </head>
    <body>
        <slot />
    </body>
</html>
